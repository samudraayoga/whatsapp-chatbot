NODE_ENV=development
PORT=3000

# Backend via `npm run dev` berjalan di host.
# Compose mengganti nilai ini menjadi `db` khusus untuk container app.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

API_KEY=development-secret-key
WA_AUTH_PATH=./auth

# Local bootstrap admin. Change these values outside local development.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
ADMIN_BOOTSTRAP_DISPLAY_NAME=Local Admin
SUPERADMIN_BOOTSTRAP_USERNAME=superadmin
SUPERADMIN_BOOTSTRAP_PASSWORD=superadmin123
SUPERADMIN_BOOTSTRAP_DISPLAY_NAME=SUPERADMIN
ADMIN_SESSION_TTL_HOURS=8
SAFETY_RESET_ENABLED=false
TRUST_PROXY_HOPS=0
# Optional comma-separated origins for a deliberately separate frontend origin.
ADMIN_ALLOWED_ORIGINS=

# Integrasi Chatbot AI — Sprint 5 Safe Chatbot Beta. Runtime customer tetap fail-closed.
AI_CHATBOT_ENABLED=false
AI_CHATBOT_STRICT_GROUNDING=true
AI_CHATBOT_DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
AI_CHATBOT_DEFAULT_TENANT_SLUG=raho
AI_CHATBOT_DEFAULT_TENANT_NAME=RAHO
AI_CHATBOT_PROVIDER=
AI_CHATBOT_CHAT_MODEL=
AI_CHATBOT_EMBEDDING_MODEL=
# Sprint 4: provider `openai-compatible` memakai endpoint kompatibel Chat Completions + Embeddings.
AI_CHATBOT_PROVIDER_BASE_URL=https://api.openai.com/v1
# Reference secret manager; jangan isi raw API key pada nilai ini.
# Contoh: env://AI_PROVIDER_API_KEY
AI_CHATBOT_PROVIDER_SECRET_REF=
# Raw token hanya berada di .env/deployment secret dan tidak pernah dikirim ke UI.
AI_PROVIDER_API_KEY=
# Hanya membuka endpoint service-to-service Alpha di local/development; customer WhatsApp belum terhubung.
AI_CHATBOT_ALPHA_RUNTIME_ENABLED=false

# Dependency async/RAG. Readiness endpoint melakukan live probe tanpa membuka secret.
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=raho-ai-knowledge
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
AI_DOCUMENT_MAX_BYTES=10485760
AI_DOCUMENT_WORKER_CONCURRENCY=2
