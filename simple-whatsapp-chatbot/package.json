{
  "name": "simple-whatsapp-chatbot",
  "version": "1.0.0",
  "description": "Simple WhatsApp chatbot backend MVP",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "predev": "npm run dev:db",
    "dev:db": "docker compose up -d --wait db",
    "dev:ai:infra:services": "docker compose -f compose.yaml -f compose.ai-development.yaml up -d --wait db redis object-storage",
    "dev:ai:init:vector": "docker compose -f compose.yaml -f compose.ai-development.yaml run --rm vector-init",
    "dev:ai:init:storage": "docker compose -f compose.yaml -f compose.ai-development.yaml run --rm object-storage-init",
    "dev:ai:infra": "npm run dev:ai:infra:services && npm run dev:ai:init:vector && npm run dev:ai:init:storage",
    "dev:host": "tsx watch src/server.ts",
    "dev:ai": "npm run dev:ai:infra && npm run dev:host",
    "dev:ai:stop": "docker compose -f compose.yaml -f compose.ai-development.yaml stop db redis object-storage",
    "dev": "tsx watch src/server.ts",
    "dev:stop": "docker compose stop db",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke:ai-documents": "tsx scripts/smoke-ai-documents.ts",
    "test:smoke:ai-rag": "tsx scripts/smoke-ai-rag.ts",
    "check": "npm run typecheck && npm run typecheck:test && npm run test && npm run build"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.13",
    "baileys-antiban": "file:../baileys-antiban",
    "bullmq": "^6.0.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "file-type": "^22.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pino": "^10.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.15",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
