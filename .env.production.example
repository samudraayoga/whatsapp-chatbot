NODE_ENV=production
PORT=3000

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_chatbot
POSTGRES_USER=whatsapp_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SERVICE_API_KEY
WA_AUTH_PATH=/app/auth

ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_ADMIN_PASSWORD
ADMIN_BOOTSTRAP_DISPLAY_NAME=WhatsApp Administrator
SUPERADMIN_BOOTSTRAP_USERNAME=superadmin
SUPERADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD
SUPERADMIN_BOOTSTRAP_DISPLAY_NAME=SUPERADMIN
ADMIN_SESSION_TTL_HOURS=8

# Keep false until a recovery operator explicitly needs credential reset.
SAFETY_RESET_ENABLED=false
# 1 for the bundled Nginx only; 2 when a TLS reverse proxy sits in front of it.
TRUST_PROXY_HOPS=2
ADMIN_ALLOWED_ORIGINS=
PRODUCTION_ENV_FILE=.env.production
CONTROL_PANEL_BIND_IP=127.0.0.1
CONTROL_PANEL_PORT=8080

# Integrasi Chatbot AI dimulai dalam keadaan nonaktif sampai seluruh release gate lulus.
AI_CHATBOT_ENABLED=false
AI_CHATBOT_STRICT_GROUNDING=true
AI_CHATBOT_DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
AI_CHATBOT_DEFAULT_TENANT_SLUG=raho
AI_CHATBOT_DEFAULT_TENANT_NAME=RAHO
AI_CHATBOT_PROVIDER=
AI_CHATBOT_CHAT_MODEL=
AI_CHATBOT_EMBEDDING_MODEL=
# Nama/path secret pada secret manager, bukan API key plaintext.
AI_CHATBOT_PROVIDER_SECRET_REF=
AI_CHATBOT_PROVIDER_BASE_URL=https://api.openai.com/v1
# Production harus tetap false sampai release gate/pilot disetujui.
AI_CHATBOT_ALPHA_RUNTIME_ENABLED=false
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=raho-ai-knowledge
OBJECT_STORAGE_REGION=us-east-1
# Gunakan credential object-storage dari secret manager/deployment secret.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
AI_DOCUMENT_MAX_BYTES=10485760
AI_DOCUMENT_WORKER_CONCURRENCY=2
